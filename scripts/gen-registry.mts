// Generates, from src/lib/curriculum.ts: src/content/registry.ts (lesson data map), src/content/bodies.ts
// (lesson body loaders for the hydration test), one static route per track and per lesson under
// src/app/learn, and stub body/data files for any lesson that does not have them yet.
// Run with: node scripts/gen-registry.mts   (Node 24 strips the types natively)
import { existsSync, mkdirSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { lessons, tracks } from "../src/lib/curriculum.ts";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const contentDir = join(root, "src", "content");

const ident = (slug: string) => slug.replace(/-/g, "_");

const stubBody = (title: string) => `"use client";

export default function Lesson() {
  return (
    <section id="theory">
      <h2>${title.replace(/'/g, "&apos;")}: this lesson is being written</h2>
      <p>Check back soon.</p>
    </section>
  );
}
`;

const stubData = `import type { LessonData } from "@/lib/curriculum";

const data: LessonData = {
  keyTerms: [],
  scenario: {
    title: "TODO",
    context: "TODO",
    symptoms: [],
    hints: [],
    rootCause: "TODO",
    fix: "TODO",
    lesson: "TODO",
  },
  interview: [],
  quiz: [],
};

export default data;
`;

let created = 0;
for (const l of lessons) {
  const dir = join(contentDir, l.track);
  mkdirSync(dir, { recursive: true });
  const body = join(dir, `${l.slug}.tsx`);
  const data = join(dir, `${l.slug}.data.ts`);
  if (!existsSync(body)) {
    writeFileSync(body, stubBody(l.title));
    created++;
  }
  if (!existsSync(data)) {
    writeFileSync(data, stubData);
    created++;
  }
}

const imports = lessons.map((l) => `import d_${ident(l.slug)} from "./${l.track}/${l.slug}.data";`).join("\n");
const dataMap = lessons.map((l) => `  "${l.slug}": d_${ident(l.slug)},`).join("\n");
const bodyMap = lessons
  .map((l) => `  "${l.slug}": () => import("./${l.track}/${l.slug}"),`)
  .join("\n");

// Lesson bodies: loader functions only, safe to import from client components (no lesson data).
const bodies = `// Generated by scripts/gen-registry.mts from src/lib/curriculum.ts. Do not edit by hand.
import type { ComponentType } from "react";

export type LessonBodyLoader = () => Promise<{ default: ComponentType }>;

export const lessonBodies: Record<string, LessonBodyLoader> = {
${bodyMap}
};
`;

// Lesson data: imported statically; used by server pages and tests only.
const registry = `// Generated by scripts/gen-registry.mts from src/lib/curriculum.ts. Do not edit by hand.
import type { LessonData } from "@/lib/curriculum";

${imports}

export const lessonData: Record<string, LessonData> = {
${dataMap}
};
`;

// One static route per track, so unknown track URLs are real 404s and the page is fully static.
const appLearnDir = join(root, "src", "app", "learn");
for (const t of tracks) {
  const dir = join(appLearnDir, t.id);
  mkdirSync(dir, { recursive: true });
  const page = `// Generated by scripts/gen-registry.mts from src/lib/curriculum.ts. Do not edit by hand.
import { TrackRoute, trackMetadata } from "@/app/learn/track-route";

export const metadata = trackMetadata("${t.id}");

export default function Page() {
  return <TrackRoute trackId="${t.id}" />;
}
`;
  writeFileSync(join(dir, "page.tsx"), page);
}

// One static route per lesson, so each route bundles only its own lesson body.
let routes = 0;
for (const l of lessons) {
  const dir = join(appLearnDir, l.track, l.slug);
  mkdirSync(dir, { recursive: true });
  const page = `// Generated by scripts/gen-registry.mts from src/lib/curriculum.ts. Do not edit by hand.
import { LessonRoute, lessonMetadata } from "@/app/learn/lesson-route";
import Body from "@/content/${l.track}/${l.slug}";
import data from "@/content/${l.track}/${l.slug}.data";

export const metadata = lessonMetadata("${l.slug}");

export default function Page() {
  return <LessonRoute slug="${l.slug}" data={data} Body={Body} />;
}
`;
  writeFileSync(join(dir, "page.tsx"), page);
  routes++;
}

writeFileSync(join(contentDir, "bodies.ts"), bodies);
writeFileSync(join(contentDir, "registry.ts"), registry);
console.log(`registry: ${lessons.length} lessons, ${created} stub files created, ${tracks.length} track routes and ${routes} lesson routes written`);
