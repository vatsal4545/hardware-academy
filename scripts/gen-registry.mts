// Generates src/content/registry.ts from src/lib/curriculum.ts and creates stub lesson files
// for any lesson that does not have a body or data module yet.
// Run with: node scripts/gen-registry.ts   (Node 24 strips the types natively)
import { existsSync, mkdirSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { lessons } from "../src/lib/curriculum.ts";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const contentDir = join(root, "src", "content");

const ident = (slug: string) => slug.replace(/-/g, "_");

const stubBody = (title: string) => `"use client";

export default function Lesson() {
  return (
    <section id="theory">
      <h2>${title.replace(/'/g, "&apos;")}: this lesson is being written</h2>
      <p>Check back soon.</p>
    </section>
  );
}
`;

const stubData = `import type { LessonData } from "@/lib/curriculum";

const data: LessonData = {
  keyTerms: [],
  scenario: {
    title: "TODO",
    context: "TODO",
    symptoms: [],
    hints: [],
    rootCause: "TODO",
    fix: "TODO",
    lesson: "TODO",
  },
  interview: [],
  quiz: [],
};

export default data;
`;

let created = 0;
for (const l of lessons) {
  const dir = join(contentDir, l.track);
  mkdirSync(dir, { recursive: true });
  const body = join(dir, `${l.slug}.tsx`);
  const data = join(dir, `${l.slug}.data.ts`);
  if (!existsSync(body)) {
    writeFileSync(body, stubBody(l.title));
    created++;
  }
  if (!existsSync(data)) {
    writeFileSync(data, stubData);
    created++;
  }
}

const imports = lessons.map((l) => `import d_${ident(l.slug)} from "./${l.track}/${l.slug}.data";`).join("\n");
const dataMap = lessons.map((l) => `  "${l.slug}": d_${ident(l.slug)},`).join("\n");
const bodyMap = lessons
  .map((l) => `  "${l.slug}": dynamic(() => import("./${l.track}/${l.slug}")),`)
  .join("\n");

const registry = `// Generated by scripts/gen-registry.ts from src/lib/curriculum.ts. Do not edit by hand.
import dynamic from "next/dynamic";
import type { ComponentType } from "react";
import type { LessonData } from "@/lib/curriculum";

${imports}

export const lessonData: Record<string, LessonData> = {
${dataMap}
};

export const lessonBodies: Record<string, ComponentType> = {
${bodyMap}
};
`;

writeFileSync(join(contentDir, "registry.ts"), registry);
console.log(`registry: ${lessons.length} lessons, ${created} stub files created`);
